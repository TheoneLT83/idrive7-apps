{
  "id": "cluster-render",
  "kind": "tool",
  "version": "0.1.0",
  "title": "Cluster renderer",
  "description": "Draws every app's layers on the instrument cluster and the HUD, sharing the display slots and one upload budget",
  "requires": {
    "mgu-deploy": "0.4.0"
  },
  "uninstallable": true,
  "files": [
    {
      "path": "cluster-render",
      "mode": "0755"
    },
    {
      "path": "cluster-render.conf",
      "mode": "0644"
    },
    {
      "path": "cluster_render_client.js",
      "mode": "0644"
    },
    {
      "path": "LICENSE",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "cluster-render.socket"
    },
    {
      "name": "cluster-render.service"
    }
  ],
  "enable": [
    {
      "unit": "cluster-render.socket",
      "target": "sockets.target"
    }
  ],
  "recmgr": [
    "cluster-render"
  ],
  "restart": [
    "cluster-render.service"
  ],
  "mguHmi": [
    "ID7"
  ]
}
